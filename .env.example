# Copy to .env for `npm run paid` locally, and add the same names in Vercel:
# Project → Settings → Environment Variables. Never commit the real .env.

# Your site's address, used for Stripe's return links (no trailing slash)
APP_URL=https://whiparound.vercel.app

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe → Developers → API keys (use test keys until you go live)
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe → Product catalog → Whiparound Pro → the two prices
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Free trial length in days (0 for none). Each account gets one trial.
TRIAL_DAYS=7

# Where scores come from in the paid version. "espn" is for testing only; its terms don't
# allow use in a product you charge for. Leave empty to have browsers use ESPN directly.
SCORES_PROVIDER=

# Team logos are trademarks. Leave false unless you've licensed them.
SHOW_TEAM_LOGOS=false
